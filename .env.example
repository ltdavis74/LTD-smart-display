# ── Smart Display configuration ──────────────────────────────────────────────
# Copy this file to .env and fill in values. None of these are committed.

# Server port (optional, defaults to 3000)
PORT=3000

# ── Location (required for weather + AI summary) ─────────────────────────────
LATITUDE=44.9778
LONGITUDE=-93.2650
CITY=Minneapolis, MN

# ── Google Calendar / Tasks (optional) ───────────────────────────────────────
# Path to an OAuth2 client credentials JSON downloaded from Google Cloud Console.
# Run the OAuth flow once locally to generate token.json, then copy both files
# to wherever the server runs.
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# Comma-separated Google Calendar IDs to include. Only events from calendars
# in this list will be shown. Find IDs in Google Calendar → Settings → "Integrate calendar".
# Example below includes a personal calendar, a shared family calendar, and US holidays.
CALENDAR_IDS=you@gmail.com,shared@group.calendar.google.com,en.usa#holiday@group.v.calendar.google.com

# ── Gemini AI summary (optional) ─────────────────────────────────────────────
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Personalize the AI briefing. Both are optional.
# HOUSEHOLD_NAME appears in the prompt ("data for the Smith household").
# HOUSEHOLD_DESCRIPTION gives the model context about who lives there so the
# greeting feels natural — names, ages, interests, anything you'd tell a new sitter.
HOUSEHOLD_NAME=the Smith household
HOUSEHOLD_DESCRIPTION=a family of four in Minneapolis — Alex (software engineer), Jordan (architect), and kids Sam (10) and Riley (7)

# ── Plex photo library (optional) ────────────────────────────────────────────
# If set, the photo carousel pulls from your local Plex server. Otherwise it
# falls back to whatever is in public/photos/.
PLEX_URL=http://192.168.1.50:32400
PLEX_TOKEN=
PLEX_PHOTO_SECTION_ID=11
