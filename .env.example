# SmartDisplayPi — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is gitignored.

# Server
PORT=3000

# Location (Open-Meteo weather API)
LATITUDE=YOUR_LATITUDE
LONGITUDE=YOUR_LONGITUDE
CITY=YOUR_CITY_STATE

# Google Calendar OAuth2
# Path to your OAuth2 credentials file (downloaded from Google Cloud Console)
GOOGLE_APPLICATION_CREDENTIALS=./client_secret.json

# Gemini AI (https://aistudio.google.com)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Plex Media Server (optional — remove if not using Plex)
PLEX_URL=http://YOUR_PLEX_SERVER_IP:32400
PLEX_TOKEN=YOUR_PLEX_TOKEN
PLEX_PHOTO_SECTION_ID=YOUR_PHOTO_SECTION_ID

# Google Keep sidecar (optional — only if using the Keep lists panel)
# Points at the host running keep_service.py. Default is 127.0.0.1:3002
# (sidecar runs on the Pi itself). Set this to a remote IP if you offload
# the sidecar to an always-on server elsewhere on your LAN.
KEEP_SIDECAR_URL=http://127.0.0.1:3002
KEEP_GROCERY_LIST=Grocery
KEEP_COSTCO_LIST=Costco
